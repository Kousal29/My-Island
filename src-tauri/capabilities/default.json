{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the island window",
  "windows": ["main", "buddy"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "store:default",
    "clipboard-manager:allow-write-text",
    "autostart:default",
    "dialog:allow-open"
  ]
}
